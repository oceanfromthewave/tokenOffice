{
  "name": "token-office",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "description": "A pixel-art office that shows your Claude Code and Codex sessions at work",
  "author": "oceanfromthewave",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "npm run build && node out/server/server.js",
    "app": "npm run build && electron .",
    "dist": "npm run typecheck && npm test && npm run build && electron-builder --publish never",
    "icon": "node tools/make-icon.ts"
  },
  "build": {
    "appId": "com.oceanfromthewave.tokenoffice",
    "productName": "tokenOffice",
    "files": [
      "out/**",
      "hook/token-office.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oceanfromthewave",
        "repo": "tokenOffice"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oceanfromthewave/tokenOffice.git"
  }
}
